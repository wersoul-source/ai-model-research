        LN2["post_attention_layernorm"]
        MLP["SwiGLU MLP:<br/>gate_proj/up_proj [14336,4096]<br/>down_proj [4096,14336]"]
        LN1 --> ATT --> LN2 --> MLP
    end

    NORM["model.norm (RMSNorm)"]
    HEAD["lm_head [128256, 4096]<br/>แยกจาก embed (tie=false)"]
    OUT["Output logits 128,256 → token<br/>eos: eot_id 128009 / eom_id 128008"]

