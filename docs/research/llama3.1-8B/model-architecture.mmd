flowchart TB
    IN["Input: text + chat format<br/><&#124;start_header_id&#124;>user<&#124;end_header_id&#124;>"]
    TOK["BPE Tokenizer<br/>vocab 128,256 (128K base + 256 special)<br/>merges 280,147"]
